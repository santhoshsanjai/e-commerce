# Copy to .env for local development. Never commit real values.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ecommerce
# Required outside local/test: at least 32 random characters, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
# JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# Must be true wherever the site is served over HTTPS (required in production)
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:4200","http://localhost:4300"]
LOG_LEVEL=INFO

# Object storage (local: `docker compose up -d s3 s3-setup`). On AWS leave S3_ENDPOINT_URL empty
# and the keys unset so the task's IAM role is used.
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=local
S3_SECRET_KEY=local
MEDIA_BUCKET=product-media
PRIVATE_BUCKET=private-files
MEDIA_PUBLIC_BASE_URL=http://localhost:8333/product-media

# Sign-in limits: failures per account, and per address across all accounts, in the window.
# LOGIN_RATE_LIMIT_ATTEMPTS=5
# LOGIN_IP_RATE_LIMIT_ATTEMPTS=30
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Proxies trusted for X-Forwarded-For (read by uvicorn). The VPC CIDR when deployed; never "*".
# FORWARDED_ALLOW_IPS=127.0.0.1

# Email. Locally, `docker compose up -d mailpit` and read mail at http://localhost:8025.
# Deployed: EMAIL_BACKEND=ses (IAM role) and EMAIL_FROM set to a verified SES sender.
# EMAIL_BACKEND=smtp
# SMTP_HOST=localhost
# SMTP_PORT=1025
# EMAIL_FROM="Shop <no-reply@example.com>"
# BUYER_SITE_URL=http://localhost:4200
# ADMIN_SITE_URL=http://localhost:4300
